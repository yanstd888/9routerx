    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.5.1",
    "autoprefixer": "^10.6.0",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.0",
    "layerchart": "^2.0.0",
    "lucide-svelte": "^1.0.1",
    "material-symbols": "^0.47.5",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.28",
    "shadcn-svelte": "^1.8.0",
    "subset-font": "^2.9.0",
    "svelte": "^5.57.0",
