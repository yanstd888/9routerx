  "version": "1.2.1",
  "description": "9RouterX native Svelte 5 dashboard — providers, combos, API keys, usage and settings for the Go gateway",
  "author": "Muhammad Dian (yanstd888) <https://github.com/yanstd888/>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanstd888/9routerx.git",
    "directory": "web"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bump-sw.mjs && npm run precompress",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:svelte": "svelte-check --tsconfig tsconfig.app.json --output machine",
    "ratchet:svelte": "bun scripts/svelte-check-ratchet.ts",
    "vendor:fonts": "bun scripts/vendor-fonts.ts",
    "precompress": "bun scripts/precompress.ts || node scripts/precompress.ts",
    "e2e": "bun test e2e/"
  },
  "dependencies": {
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
